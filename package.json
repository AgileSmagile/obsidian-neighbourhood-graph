{
  "name": "obsidian-neighbourhood-graph",
  "version": "0.1.0",
  "description": "Interactive D3.js neighbourhood graph for Obsidian — shows the current note's connections in a sidebar panel",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "lint": "eslint src/ --ext .ts",
    "dev:sandbox": "node esbuild.config.mjs sandbox",
    "build:sandbox": "node esbuild.config.mjs sandbox once",
    "screenshots": "npm run build:sandbox && node scripts/screenshots.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/d3": "^7.4.0",
    "@types/node": "^16.11.6",
    "esbuild": "0.17.3",
    "eslint": "^8.0.0",
    "obsidian": "latest",
    "playwright-core": "^1.63.0",
    "tslib": "2.4.0",
    "typescript": "5.0.4",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "d3": "^7.9.0"
  }
}
